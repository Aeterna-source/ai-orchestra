SUPABASE_URL=
SUPABASE_KEY=
# Prefer this on the backend if Supabase RLS blocks memory tables.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional: OpenAI-compatible local server, for example LM Studio or Ollama /v1.
LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_AI_API_KEY=local
LOCAL_AI_MODEL=local-model
LOCAL_AI_PROFILE=Reon

# Optional model overrides.
NEVAN_MODEL=gpt-4o-2024-11-20
SPUD_MODEL=gpt-5.5
REON_MODEL=gpt-5.1
GROKULCHIK_MODEL=grok-4.3

# Telegram bots.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_GROUP_IDS=
TELEGRAM_NEVAN_TOKEN=
TELEGRAM_SPUD_TOKEN=
TELEGRAM_GROKULCHIK_TOKEN=
TELEGRAM_REON_TOKEN=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_ADMIN_SECRET=
TELEGRAM_REACTIONS_ENABLED=true
TELEGRAM_GROUP_FALLBACK_LIMIT=80
TELEGRAM_MESSAGE_CHUNK_SIZE=3200

# Keep this false unless you explicitly want Grok to spend an extra request
# on trigger routing before every reply.
XAI_TRIGGER_CLASSIFIER=false
